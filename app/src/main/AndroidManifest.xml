<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="ViewMage"
        android:allowBackup="false"
        android:hasFragileUserData="false">

        <activity
            android:name="io.nava.viewmage.ViewMageActivity"
            android:exported="true"
            android:label="ViewMage"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">

            <!-- The library NativeActivity dlopen()s. Note that this load does
                 NOT register the library with the JVM, which is why
                 ViewMageActivity has a System.loadLibrary block of its own. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="viewmage" />

            <!-- ViewMage is opened FROM a file manager and has no launcher
                 icon on purpose: an image viewer with no image to view has
                 nothing to show, and a home-screen entry that always says
                 "No image to show" is a bug report waiting to happen. -->

            <!-- The correct declaration: a registered JPEG XL media type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/jxl" />
            </intent-filter>

            <!-- …and the declaration reality needs. Plenty of file managers and
                 providers do not know the type yet and send a .jxl as
                 application/octet-stream, or as */*, having only the name to
                 go on. Matching the extension as well is what makes ViewMage
                 actually appear in the "Open with" list on a real device.
                 pathPattern is glob-ish, not a regex: ".*\\.jxl" is the
                 documented spelling. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.jxl" />
                <data android:pathPattern=".*\\..*\\.jxl" />
                <data android:pathPattern=".*\\..*\\..*\\.jxl" />
                <data android:pathPattern=".*\\.JXL" />
            </intent-filter>
        </activity>
    </application>
</manifest>
