# Build trees
build/
.cxx/
app/build/
.gradle/
local.properties

# The release signing key (points at Matrix_Player's bruno.jks).
keystore.properties

# Reading reference only — oupson/jxlviewer, not a dependency of this project.
# Cloned by hand into reference/ to read its libjxl wiring; nothing here builds
# against it and nothing here links it.
reference/

# Sitting in the workspace, not consumed by ViewMage.
firstparty/

# The wrapper binary itself is a local tool, not project source.
git_wrapper

# Editor / tooling
compile_commands.json
.idea/
*.iml
.DS_Store

# The neural denoiser: a 31 MB model and a 17 MB runtime, both fetched by
# tools/ rather than versioned. Binaries do not belong in git, and both are
# reproducible from a pinned upstream release.
app/src/main/assets/models/
thirdparty/onnxruntime/include/
thirdparty/onnxruntime/lib/
